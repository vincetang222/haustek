+/* ---------- 9. giới hạn công bố ---------- */
+/* Con số công bố cho CRM phải KHỚP điều Portal thật sự nhận. Nếu nó chỉ là
+   một bảng gõ tay cạnh contractCalc thì sớm muộn hai bên lệch nhau, và
+   người bán lại hứa với khách một con số Portal không nhận. */
+check("Giới hạn công bố khớp đúng điều Portal thật sự nhận", () => {
+  const gh = A.thuongVu.gioiHan();
+  const thu = (t) => trinhThu(benTrong(), Object.assign({ artistSharePct: 70, termMonths: 24, totalAdvanceUSD: 0 }, t));
+
+  must(thu({ termMonths: gh.termMonths.max }).ok, "trần " + gh.termMonths.max + " tháng phải nhận được");
+  must(!thu({ termMonths: gh.termMonths.max + 1 }).ok, "trên trần một tháng phải bị chặn");
+  must(thu({ termMonths: gh.termMonths.min }).ok, "sàn " + gh.termMonths.min + " tháng phải nhận được");
+  must(!thu({ termMonths: gh.termMonths.min - 1 }).ok, "dưới sàn một tháng phải bị chặn");
+
